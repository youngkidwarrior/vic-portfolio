{
  "name": "victor-ginelli-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:resume": "python3 scripts/build_resume.py",
    "setup:resume": "python3 -m pip install --requirement requirements.txt",
    "build:sites": "bun run build && rm -rf ./dist && mkdir -p ./dist/server ./dist/client && cp -R ./build/client/. ./dist/client/ && cp ./sites-worker.mjs ./dist/server/index.js",
    "dev": "react-router dev",
    "start": "python3 -m http.server --directory build/client --bind 127.0.0.1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && playwright test",
    "check": "bun run typecheck && bun run test && bun run build",
    "test:e2e:built": "playwright test",
    "test:motion": "bun run build && MOTION_REVIEW=1 playwright test tests/e2e/motion.spec.ts tests/e2e/project-transitions.spec.ts",
    "check:all": "bun run check && bun run test:e2e:built",
    "report:assets": "bun scripts/asset-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "latest",
    "@react-router/node": "7.9.5",
    "@react-router/serve": "7.9.5",
    "isbot": "5.1.31",
    "motion": "13.1.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "7.9.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@react-router/dev": "7.9.5",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "22",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "26.1.0",
    "tailwindcss": "latest",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
